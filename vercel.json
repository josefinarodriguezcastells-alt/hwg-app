{
  "functions": {
    "api/generate.js": {
      "maxDuration": 60
    },
    "api/extract-profile.js": {
      "maxDuration": 60
    },
    "api/docx.js": {
      "maxDuration": 60
    },
    "api/save-profile.js": {
      "maxDuration": 30
    },
    "api/config.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
